# ==============================================================================
# InternConnect Production Environment Configuration Reference
# DO NOT COMMIT ACTUAL SECRETS TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (e.g. Deployed on Railway or Render)
# ------------------------------------------------------------------------------

# Port for the Node.js HTTP server (Hosting providers like Railway/Render set this automatically)
PORT=5001

# Application environment
NODE_ENV=production

# Cloud PostgreSQL Connection String (from Neon, Supabase, or Railway)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_SECRET_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/internconnect?sslmode=require

# Secret key used for signing JWT tokens (generate a long 64-character random string)
# Tip to generate: run `openssl rand -hex 32` in your terminal
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_for_production

# Token expiration duration (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Public URL of your deployed frontend client (used for CORS permissions)
CLIENT_URL=https://internconnect.vercel.app


# ------------------------------------------------------------------------------
# 2. FRONTEND SERVICE (e.g. Deployed on Vercel)
# ------------------------------------------------------------------------------

# Base URL pointing to your deployed backend API
# Must include '/api' at the end
VITE_API_URL=https://your-internconnect-backend.up.railway.app/api
